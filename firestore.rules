rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Conteúdo do portfólio: qualquer visitante lê, só o dono grava.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'jvdev2026@jvdev.app';
    }

    // Todo o resto fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
